# Copie para .env.local e preencha. Os dois primeiros saem de
# Dashboard > Project Settings > API Keys (sao publicos, vao para o navegador).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...). Ignora RLS. So o tools/upload-assets.mjs precisa dela,
# e so na maquina de quem sobe as imagens. Nunca vai para a Vercel.
SUPABASE_SECRET_KEY=
